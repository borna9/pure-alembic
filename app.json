{
  "expo": {
    "name": "Pure Alembic",
    "slug": "pure-alembic",
    "version": "0.1.0",
    "scheme": "purealembic",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.firststirrings.purealembic",
      "appleTeamId": "6M42Y965MV",
      "infoPlist": {
        "NSCalendarsFullAccessUsageDescription": "Pure Alembic creates calendar events for the tasks you plan.",
        "NSRemindersFullAccessUsageDescription": "Pure Alembic creates reminders for tasks that have no date or hours."
      }
    },
    "android": {
      "package": "com.firststirrings.purealembic",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Pure Alembic creates calendar events for the tasks you plan.",
          "remindersPermission": "Pure Alembic creates reminders for tasks that have no date or hours."
        }
      ]
    ]
  }
}
