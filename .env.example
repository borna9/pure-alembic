# Pure Alembic build-time configuration. Copy to .env and fill in.
# All of these are PUBLIC identifiers (safe to expose in the client);
# secrets never live here.

# Supabase project (accounts + sync) — docs/SETUP.md §1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Calendar OAuth clients — docs/SETUP.md §2
# Web application client (web builds):
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# iOS client (native builds; custom-scheme redirect, no secret):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Microsoft (Outlook Calendar + To Do) app registration — docs/SETUP.md §3
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
